<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:network="using:CrossPlatformMicStreamer.Network"
        xmlns:audio="using:CrossPlatformMicStreamer.Audio"
        xmlns:controls="using:CrossPlatformMicStreamer.Controls"
        xmlns:conv="using:CrossPlatformMicStreamer.Converters"
        xmlns:vm="using:CrossPlatformMicStreamer.ViewModels"
        mc:Ignorable="d"
        d:DesignWidth="430"
        d:DesignHeight="400"
        x:Class="CrossPlatformMicStreamer.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="MicBeam"
        Icon="/Assets/MicBeam.ico"
        Width="430"
        SizeToContent="Height"
        MinWidth="320">
    <Grid Margin="12" RowDefinitions="Auto,Auto,Auto,Auto">
        <Border Grid.Row="0"
                Classes="Card"
                Padding="4"
                Margin="0,0,0,8">
            <Grid ColumnDefinitions="*,*">
                <ToggleButton Grid.Column="0"
                              Classes="ModeToggle"
                              IsChecked="{Binding IsSendMode}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <controls:LucideIcon Kind="Mic" Width="16" Height="16" />
                        <TextBlock Text="Send" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton Grid.Column="1"
                              Classes="ModeToggle"
                              IsChecked="{Binding IsReceiveMode}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <controls:LucideIcon Kind="Volume2" Width="16" Height="16" />
                        <TextBlock Text="Receive" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Spacing="6" Margin="0,0,0,8">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="SectionHeader"
                           Text="PEERS"
                           Margin="0"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Classes="IconButton Compact"
                        Click="OnRefreshClicked"
                        ToolTip.Tip="Refresh">
                    <controls:LucideIcon Kind="RefreshCw"
                                         Width="16"
                                         Height="16"
                                         Foreground="{StaticResource TextMutedBrush}" />
                </Button>
            </Grid>

            <ListBox ItemsSource="{Binding Peers}"
                     SelectedItem="{Binding SelectedPeer, Mode=TwoWay}"
                     Background="Transparent"
                     BorderThickness="0"
                     MinHeight="72"
                     MaxHeight="120">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,3" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                    <Style Selector="ListBoxItem:selected Border.PeerRow">
                        <Setter Property="Background" Value="#1E3A5F" />
                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="network:PeerInfo">
                        <Border Classes="PeerRow">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <controls:LucideIcon Grid.Column="0"
                                                     Kind="CircleDot"
                                                     Width="10"
                                                     Height="10"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,8,0"
                                                     Foreground="{StaticResource TextMutedBrush}" />
                                <StackPanel Grid.Column="1" Spacing="1">
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Address}"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="11" />
                                </StackPanel>
                                <controls:LucideIcon Grid.Column="2"
                                                     Kind="Link"
                                                     Width="14"
                                                     Height="14"
                                                     VerticalAlignment="Center"
                                                     Foreground="{StaticResource TextMutedBrush}"
                                                     IsVisible="{Binding IsManual}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid ColumnDefinitions="*,Auto">
                <TextBox x:Name="ManualIpTextBox"
                         PlaceholderText="IP address"
                         KeyDown="OnManualIpKeyDown" />
                <Button Grid.Column="1"
                        Classes="IconButton Compact"
                        Margin="6,0,0,0"
                        Click="OnAddPeerClicked"
                        ToolTip.Tip="Add">
                    <controls:LucideIcon Kind="Plus"
                                         Width="16"
                                         Height="16"
                                         Foreground="{StaticResource TextPrimaryBrush}" />
                </Button>
            </Grid>
        </StackPanel>

        <Border Grid.Row="2"
                Classes="Card"
                Padding="10,8"
                Margin="0,0,0,8">
            <StackPanel Spacing="6">
                <TextBlock Classes="SectionHeader" Text="FORMAT" Margin="0" />
                <ComboBox ItemsSource="{Binding BitDepthOptions}"
                          SelectedItem="{Binding SelectedBitDepth}"
                          HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="audio:AudioBitDepth">
                            <TextBlock Text="{Binding Converter={x:Static conv:AudioBitDepthLabelConverter.Instance}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <StackPanel IsVisible="{Binding IsSendMode}" Spacing="6">
                    <TextBlock Classes="SectionHeader" Text="MICROPHONE" Margin="0" />
                    <ComboBox ItemsSource="{Binding InputDevices}"
                              SelectedItem="{Binding SelectedInputDevice}"
                              HorizontalAlignment="Stretch"
                              PlaceholderText="Microphone">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="audio:AudioDeviceInfo">
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <controls:VuMeter Level="{Binding InputMeterLevel}" />
                </StackPanel>

                <StackPanel IsVisible="{Binding IsReceiveMode}" Spacing="6">
                    <TextBlock Classes="SectionHeader" Text="OUTPUT" Margin="0" />
                    <ComboBox ItemsSource="{Binding OutputDevices}"
                              SelectedItem="{Binding SelectedOutputDevice}"
                              HorizontalAlignment="Stretch"
                              PlaceholderText="Speaker">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="audio:AudioDeviceInfo">
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <controls:VuMeter Level="{Binding OutputMeterLevel}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="3"
                Padding="8,6"
                Background="{StaticResource SurfaceRaisedBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid RowDefinitions="Auto,Auto">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                Spacing="6"
                                VerticalAlignment="Center">
                        <controls:LucideIcon Width="14"
                                             Height="14"
                                             VerticalAlignment="Center"
                                             Kind="{Binding ConnectionPhase, Converter={x:Static conv:ConnectionPhaseToIconConverter.Instance}}"
                                             Foreground="{Binding ConnectionPhase, Converter={x:Static conv:ConnectionPhaseToBrushConverter.Instance}}" />
                        <TextBlock Text="{Binding FooterText}"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="4"
                                VerticalAlignment="Center">
                        <TextBlock Text="buf"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="{Binding BufferMs}"
                                   IsVisible="{Binding !IsEditingBuffer}"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   MinWidth="20"
                                   TextAlignment="Right"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBox x:Name="BufferEditTextBox"
                                 Text="{Binding BufferEditText}"
                                 IsVisible="{Binding IsEditingBuffer}"
                                 Width="48"
                                 VerticalAlignment="Center"
                                 KeyDown="OnBufferEditKeyDown" />
                        <TextBlock Text="ms"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}" />
                        <Button Classes="IconButton Compact"
                                Click="OnBufferEditClicked"
                                ToolTip.Tip="Edit buffer">
                            <controls:LucideIcon Kind="Pencil"
                                                 Width="14"
                                                 Height="14"
                                                 Foreground="{StaticResource TextMutedBrush}" />
                        </Button>
                        <ToggleButton Classes="IconToggle Compact"
                                      IsChecked="{Binding IsBufferLocked}"
                                      ToolTip.Tip="Lock buffer">
                            <controls:LucideIcon Width="14"
                                                 Height="14"
                                                 Kind="{Binding IsBufferLocked, Converter={x:Static conv:BoolToLucideKindConverter.Instance}, ConverterParameter=Lock}" />
                        </ToggleButton>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1"
                      ColumnDefinitions="Auto,*,Auto,*,Auto,*,Auto,*,Auto"
                      Margin="0,6,0,0"
                      IsVisible="{Binding ShowBufferTestStats}">
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                Spacing="5"
                                VerticalAlignment="Center"
                                ToolTip.Tip="Underruns: output starved (needs more buffer)">
                        <controls:LucideIcon Kind="VolumeX"
                                             Width="13"
                                             Height="13"
                                             VerticalAlignment="Center"
                                             Foreground="{Binding BufferStatUnderrunsOver, Converter={x:Static conv:BoolToStatForegroundConverter.Instance}}" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="0">
                            <TextBlock Text="{Binding BufferStatUnderruns}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="/" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="{Binding BufferStatUnderrunLimit}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="5"
                                VerticalAlignment="Center"
                                ToolTip.Tip="Saturated: incoming queue full, chunks dropped">
                        <controls:LucideIcon Kind="Layers"
                                             Width="13"
                                             Height="13"
                                             VerticalAlignment="Center"
                                             Foreground="{Binding BufferStatSaturatedOver, Converter={x:Static conv:BoolToStatForegroundConverter.Instance}}" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="0">
                            <TextBlock Text="{Binding BufferStatSaturated}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="/" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="{Binding BufferStatSaturatedLimit}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="4"
                                Orientation="Horizontal"
                                Spacing="5"
                                VerticalAlignment="Center"
                                ToolTip.Tip="Dropped: capture/send queue overflow">
                        <controls:LucideIcon Kind="Trash2"
                                             Width="13"
                                             Height="13"
                                             VerticalAlignment="Center"
                                             Foreground="{Binding BufferStatDropsOver, Converter={x:Static conv:BoolToStatForegroundConverter.Instance}}" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="0">
                            <TextBlock Text="{Binding BufferStatDrops}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="/" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="{Binding BufferStatDropLimit}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="6"
                                Orientation="Horizontal"
                                Spacing="5"
                                VerticalAlignment="Center"
                                ToolTip.Tip="Bad windows toward +5 ms buffer increase">
                        <controls:LucideIcon Kind="TrendingUp"
                                             Width="13"
                                             Height="13"
                                             VerticalAlignment="Center"
                                             Foreground="{StaticResource TextMutedBrush}" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="0">
                            <TextBlock Text="{Binding BufferStatBadWindows}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="/" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="{Binding BufferStatBadLimit}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="8"
                                Orientation="Horizontal"
                                Spacing="5"
                                VerticalAlignment="Center"
                                ToolTip.Tip="Stable windows toward −5 ms buffer decrease">
                        <controls:LucideIcon Kind="TrendingDown"
                                             Width="13"
                                             Height="13"
                                             VerticalAlignment="Center"
                                             Foreground="{StaticResource TextMutedBrush}" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="0">
                            <TextBlock Text="{Binding BufferStatStableWindows}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="/" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="{Binding BufferStatStableLimit}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
